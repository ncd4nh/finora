# Cổng API
PORT=4000

# Database online Turso (bỏ trống -> dùng file server/data/finora.db trên máy)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Chỉ cần khi giao diện và API ở 2 domain khác nhau (cách nhau dấu phẩy). Bỏ trống = cho phép tất cả
CORS_ORIGIN=

# Chat AI (tuỳ chọn). Bỏ trống -> chat vẫn hiểu công thức "Chi 100k Ăn uống Techcombank"
ANTHROPIC_API_KEY=
# Model Claude, đổi sang model mới hơn nếu muốn
ANTHROPIC_MODEL=claude-sonnet-4-5

# Địa chỉ giao diện (dùng tạo link đặt lại mật khẩu trong email)
APP_URL=http://localhost:5173

# Gửi email quên mật khẩu (bỏ trống -> email được in ra console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Finora <no-reply@your-domain.com>
