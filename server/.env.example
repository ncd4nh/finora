# Cổng API
PORT=4000

# Domain frontend được phép gọi API (cách nhau dấu phẩy). Bỏ trống = cho phép tất cả
CORS_ORIGIN=
# Thư mục dữ liệu: auth.db (tài khoản) + users/<id>.db (dữ liệu từng người)
# DATA_DIR=./data

# Chat AI (tuỳ chọn). Bỏ trống -> chat vẫn hiểu công thức "Chi 100k Ăn uống Techcombank"
ANTHROPIC_API_KEY=
# Model Claude, đổi sang model mới hơn nếu muốn
ANTHROPIC_MODEL=claude-sonnet-4-5

# Địa chỉ giao diện (dùng tạo link đặt lại mật khẩu trong email)
APP_URL=http://localhost:5173

# Gửi email quên mật khẩu (bỏ trống -> email được in ra console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Finora <no-reply@your-domain.com>
